# bubbleidle config. Copy to .env (repo root) or ~/.config/bubbleidle/.env, chmod 600.
# Real environment variables win over both files.

# Bot account: a SEPARATE Bubble account (email+password, not Google SSO) invited as a
# collaborator on the app with edit rights. Bubble allows one person / one session per login.
BUBBLE_EMAIL=bot@example.com
BUBBLE_PASSWORD=...

# Default app id = the subdomain part, e.g. "myapp" in myapp.bubbleapps.io ( `bubble apps` lists them )
BUBBLE_APP_ID=myapp

# Which version to read/write. "test" = development. Writes to "live" are always refused.
BUBBLE_VERSION=test

# Optional
# CHROMIUM_PATH=/usr/bin/chromium        # browser used for login/screenshots
# BUBBLEIDLE_STATE=/path/to/state        # default: <repo>/.state
# BUBBLEIDLE_MAX_WRITES=200              # write cap per process (safety)
# BUBBLEIDLE_INTERVAL=300                # watcher poll seconds
# BUBBLEIDLE_WATCH_APPS=app1,app2        # watcher targets (default: BUBBLE_APP_ID)
# BUBBLEIDLE_ON_EVENT='claude -p "triage this event"'   # watcher hook; event JSON on stdin
